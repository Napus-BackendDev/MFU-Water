# KOK Water Watch server-side Supabase configuration
# Never prefix these with VITE_: keys must not enter the browser bundle.
# Development accepts loopback Supabase only. No automatic Cloud fallback.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
ADMIN_CSRF_SECRET=replace-with-random-secret-at-least-32-characters

# Production deployment only: set secrets in the server's secret manager.
# Use the Supabase Cloud project URL and keys there; do not copy real values here.
# NODE_ENV=production
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=replace-in-secret-manager
# SUPABASE_SERVICE_ROLE_KEY=replace-in-secret-manager
# ADMIN_CSRF_SECRET=replace-in-secret-manager
# PUBLIC_APP_URL=https://your-app.example
# ENABLE_ADMIN_INVITES=true
# SMTP_HOST=replace-in-secret-manager
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=replace-in-secret-manager
# SMTP_PASSWORD=replace-in-secret-manager
# SMTP_FROM=water-watch@example.org
# ENABLE_SMTP_DELIVERY=true
