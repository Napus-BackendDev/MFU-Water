VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Public browser key for MapTiler Satellite. Restrict allowed referrers/domains in MapTiler.
VITE_MAPTILER_API_KEY=
VITE_TURNSTILE_SITE_KEY=
VITE_TURNSTILE_ENABLED=false

# Vercel server-only secrets; never prefix with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=
SURVEY_SIGNING_SECRET=
ADMIN_PASSCODE=mfu2026admin

# Local path stays server-side. Use the sensitive JSON variable on Vercel.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Explicit opt-in to the linked Supabase cloud project during development.
VITE_ALLOW_HOSTED_SUPABASE=false
