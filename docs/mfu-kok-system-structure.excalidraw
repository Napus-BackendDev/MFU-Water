      "boundElements": [],
      "updated": 1793812811746,
      "link": null,
      "locked": false,
      "text": "💡 สถานะปัจจุบัน, สิ่งที่ได้กลับไป และการนำไปใช้ประโยชน์ (Needs & Value)",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 16,
      "containerId": null,
      "originalText": "💡 สถานะปัจจุบัน, สิ่งที่ได้กลับไป และการนำไปใช้ประโยชน์ (Needs & Value)",
      "lineHeight": 1.38
    },
    {
      "id": "mod-2-c3",
      "type": "text",
      "x": 150,
      "y": 2055,
      "width": 1112,
      "height": 67,
      "angle": 0,
      "strokeColor": "#713F12",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
