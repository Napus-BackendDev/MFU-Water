    },
    {
      "id": "mod-2-c2",
      "type": "text",
      "x": 150,
      "y": 1775,
      "width": 820,
      "height": 67,
      "angle": 0,
      "strokeColor": "#15803D",
      "backgroundColor": "transparent",
