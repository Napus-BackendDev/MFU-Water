    {
      "id": "mod-6-c2",
      "type": "text",
      "x": 5550,
      "y": 1775,
      "width": 1048,
      "height": 67,
      "angle": 0,
      "strokeColor": "#15803D",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
