    },
    {
      "id": "mod-3-c2",
      "type": "text",
      "x": 2850,
      "y": 625,
      "width": 966,
      "height": 67,
      "angle": 0,
      "strokeColor": "#15803D",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
