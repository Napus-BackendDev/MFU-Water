function createVillagerForm() {
  const form = FormApp.create('ลองใช้แอปตรวจน้ำแล้ว เป็นอย่างไรบ้าง (ฉบับอาสาสมัคร)')
  form.setDescription(
    'ขอบคุณที่ช่วยลองใช้แอปตรวจน้ำแม่น้ำกกครับ/ค่ะ\n' +
    'ตอบตามที่รู้สึกจริงได้เลย ไม่มีคำตอบถูกหรือผิด ใช้เวลาประมาณ 12 นาที\n' +
    'ถ้าอ่านหรือกดไม่สะดวก บอกทีมงานให้ช่วยอ่านและกดแทนได้'
  )
  form.setProgressBar(true)
  form.setShowLinkToRespondAgain(false)

  let number = 0
  SECTIONS.forEach(([section, questions], index) => {
    if (index === 0) form.addSectionHeaderItem().setTitle(section)
    else form.addPageBreakItem().setTitle(section)
    questions.forEach(([kind, text, options, note]) => {
      number += 1
      const title = number + '. ' + text
      let item
      if (kind === 'text') item = form.addParagraphTextItem().setTitle(title).setRequired(false)
      else if (kind === 'many') item = form.addCheckboxItem().setTitle(title).setChoiceValues(options).setRequired(true)
      else item = form.addMultipleChoiceItem().setTitle(title).setChoiceValues(options).setRequired(true)
      if (note) item.setHelpText(note)
    })
  })

  form.setConfirmationMessage('ขอบคุณมากครับ/ค่ะ ความเห็นของคุณช่วยให้แอปใช้ง่ายขึ้นสำหรับทุกคนในหมู่บ้าน')
  Logger.log('ลิงก์แก้ไขฟอร์ม: ' + form.getEditUrl())
  Logger.log('ลิงก์ส่งให้ชาวบ้านตอบ: ' + form.getPublishedUrl())
}
